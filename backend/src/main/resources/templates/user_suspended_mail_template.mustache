<div style="display: table; width: 100%; min-height: 60vh; background: linear-gradient(135deg, {{primary_100}} 0%, {{primary_200}} 100%); font-family: Fredoka, Trebuchet MS, Helvetica, Arial, sans-serif;">
    <div style="display: table-row; height: 100%; width: 100%">
        <div style="display: table-cell; vertical-align: middle; text-align: center;">
            <div style="margin-left: 2rem; margin-right: 2rem;">
                <div style="margin: 2rem auto; padding: 2rem; border-radius: 1rem; text-align: center; background: {{primary_200_40}}; width: 80%; min-height: 200px; border: 1px solid {{glass_border}}; backdrop-filter: blur(10px); box-shadow: 0 8px 10px rgba(0, 0, 0, 0.1); border-radius: 1.5rem;">
                    <img src="https://i.imgur.com/lSHl47F.png" alt="Rarecips Logo" style="height: 40%; width: 40%; margin-bottom: 2rem; margin-top: 2rem; display: block; margin-left: auto; margin-right: auto;">
                    <div style="margin: 0 auto; text-align: center; background: {{primary_200}}; border-radius: 1rem; padding: 2rem; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); width: 60%; min-height: 200px; height: auto; display: table;">
                        <div style="display: table-row; height: 50px;">
                            <h2 style="display: table-cell; color: {{primary_text}}; vertical-align: middle;">{{suspension_title}}</h2>
                        </div>
                        <div style="display: table-row; height: 70px;">
                            <span style="display: table-cell; color: {{primary_text}}; font-size: medium; vertical-align: middle;">{{suspension_message}}</span>
                        </div>
                        <div style="display: table-row; height: 60px;">
                            <span style="display: table-cell; color: {{primary_text}}; font-size: medium; vertical-align: middle;">{{suspension_next_steps}}</span>
                        </div>
                        <div style="display: table-row; height: 30px;">
                            <span style="display: table-cell; color: {{primary_text}}; font-weight: 600; vertical-align: middle;">{{contact_label}}: <a href="mailto:{{fromAddress}}" style="color: {{primary_600}}; text-decoration: underline;">{{fromAddress}}</a></span>
                        </div>
                        <div style="display: table-row; height: 20px;">
                            <div style="display: table-cell; font-size: small; color: {{primary_text}}; font-weight: normal; vertical-align: middle; text-align: right; padding-top: 2rem;">{{timestamp}}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

